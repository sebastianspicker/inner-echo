{
  "name": "inner-echo",
  "private": true,
  "version": "0.1.0-alpha.1",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "license": "MIT",
  "author": "Sebastian Spicker",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.domain.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.tools.json --noEmit && tsc -p tsconfig.tests.json --noEmit",
    "build": "npm run typecheck && vite build",
    "bundle:verify": "node tools/release/verify-runtime-chunks.mjs",
    "lint": "biome check --error-on-warnings src/ tests/ tools/ vite.config.ts",
    "quality:duplication": "jscpd src tests tools vite.config.ts --config .jscpd.json --exit-code 1",
    "quality:check": "npm run lint && npm run quality:duplication",
    "architecture:check": "node tools/architecture/check-imports.mjs",
    "test": "vitest run",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "notices:verify": "node tools/release/verify-third-party-notices.mjs --require-dist",
    "preview": "vite preview",
    "docs:gen": "tsx tools/docs/gen-docs.ts",
    "docs:verify": "tsx tools/docs/gen-docs.ts --check",
    "docs:links": "node tools/docs/check-markdown-links.mjs",
    "conditions:validate": "tsx tools/validation/validate-experience-content.ts",
    "composer:validate": "tsx tools/validation/validate-composition.ts",
    "evidence:gen": "tsx tools/docs/evidence-pages-gen.ts",
    "evidence:verify": "tsx tools/docs/evidence-verify.ts",
    "debug:inspect": "tsx tools/validation/inspect/debug-inspect.ts",
    "verify:contracts": "tsx tools/contracts/verify-contracts.ts",
    "verify": "npm run build && npm run bundle:verify && npm run notices:verify && npm run verify:source",
    "check": "npm run verify",
    "clean:local": "rm -rf dist reports tsconfig.tsbuildinfo",
    "pages:build": "node tools/deployment/build-pages.mjs",
    "pages:preview": "node tools/deployment/preview-pages.mjs",
    "pages:verify": "node tools/deployment/verify-pages-build.mjs && npm run bundle:verify",
    "release:alpha:local": "npm run audit:dependencies && npm run check",
    "release:alpha:checklist": "npm run clean:local && npm ci --ignore-scripts && npm rebuild esbuild && npm run release:alpha:local",
    "verify:source": "npm run docs:verify && npm run docs:links && npm run quality:check && npm run architecture:check && npm test && npm run conditions:validate && npm run composer:validate && npm run evidence:verify && npm run verify:contracts && npm run debug:inspect"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/node": "^25.5.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jscpd": "5.1.2",
    "jsdom": "^29.0.1",
    "tsx": "^4.22.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.11"
  }
}
