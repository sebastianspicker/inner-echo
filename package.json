{
  "name": "inner-echo",
  "private": true,
  "version": "0.1.0-alpha.1",
  "packageManager": "npm@11.17.0",
  "engines": {
    "node": "22.x"
  },
  "type": "module",
  "license": "MIT",
  "author": "Sebastian Spicker",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.domain.json --noEmit && tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "npm run typecheck && vite build",
    "bundle:verify": "node tools/release/verify-runtime-chunks.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "notices:verify": "node tools/release/verify-third-party-notices.mjs --require-dist",
    "preview": "vite preview",
    "verify": "npm run build && npm run bundle:verify && npm run notices:verify",
    "check": "npm run verify",
    "clean:local": "rm -rf dist reports tsconfig.tsbuildinfo",
    "pages:build": "node tools/deployment/build-pages.mjs",
    "pages:preview": "node tools/deployment/preview-pages.mjs",
    "pages:verify": "node tools/deployment/verify-pages-build.mjs && npm run bundle:verify",
    "release:alpha:local": "npm run audit:dependencies && npm run check",
    "release:alpha:checklist": "npm run clean:local && npm ci --ignore-scripts && npm rebuild esbuild && npm run release:alpha:local"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^17.0.5",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "three": "^0.183.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.1",
    "typescript": "~6.0.2",
    "vite": "^8.1.5"
  }
}
