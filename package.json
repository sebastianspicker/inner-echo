{
  "name": "inner-echo",
  "private": true,
  "version": "0.1.0-rc.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:e2e": "npm run test:e2e:ui && npm run test:e2e:cross-browser",
    "test:e2e:ui": "node tests/e2e/ui-debug.e2e.mjs",
    "test:e2e:cross-browser": "node tests/e2e/cross-browser-smoke.e2e.mjs",
    "preview": "vite preview",
    "docs:gen": "tsx scripts/gen-docs.ts",
    "conditions:validate": "tsx scripts/conditions-validate.ts",
    "composer:validate": "tsx scripts/composer-validate.ts",
    "evidence:gen": "tsx scripts/evidence-pages-gen.ts",
    "evidence:verify": "tsx scripts/evidence-verify.ts",
    "nodes:report": "tsx scripts/nodes-report.ts",
    "references:audit": "tsx scripts/references-audit.ts",
    "runtime:matrix": "tsx scripts/runtime-matrix.ts",
    "debug:inspect": "npm run lint && npm test && npm run verify:contracts && tsx scripts/debug-inspect.ts",
    "verify:contracts": "tsx scripts/verify-contracts.ts",
    "verify": "npm run build && npm test && npm run conditions:validate && npm run composer:validate && npm run evidence:verify && npm run verify:contracts",
    "check": "npm run verify && npm run test:e2e",
    "clean:local": "rm -rf dist reports tsconfig.tsbuildinfo",
    "screenshots:capture": "node tests/e2e/readme-screenshots.mjs",
    "screenshots:convert": "node scripts/convert-readme-screenshots.mjs",
    "screenshots:readme": "npm run screenshots:capture && npm run screenshots:convert",
    "screenshots:verify": "node scripts/verify-readme-screenshots.mjs",
    "release:rc:local": "npm run check",
    "release:rc:checklist": "npm run clean:local && npm ci && npm run check && npm run screenshots:readme && npm run screenshots:verify"
  },
  "dependencies": {
    "dompurify": "^3.3.1",
    "marked": "^17.0.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.182.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.182.0",
    "@vitejs/plugin-react": "^4.3.3",
    "playwright": "^1.58.2",
    "sharp": "^0.34.5",
    "tsx": "^4.19.2",
    "typescript": "~5.6.2",
    "vite": "^5.4.10",
    "vitest": "^4.0.18"
  }
}
