{
  "name": "inner-echo",
  "private": true,
  "version": "0.1.0-alpha.1",
  "type": "module",
  "license": "MIT",
  "author": "Sebastian Spicker",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "build": "tsc -b && vite build",
    "lint": "biome check --error-on-warnings src/ tests/ scripts/",
    "lint:biome": "biome check src/ tests/ scripts/",
    "test": "vitest run",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "notices:verify": "node scripts/release/verify-third-party-notices.mjs --require-dist",
    "preview": "vite preview",
    "docs:gen": "tsx scripts/docs/gen-docs.ts",
    "docs:links": "node scripts/docs/check-markdown-links.mjs",
    "conditions:validate": "tsx scripts/validation/conditions-validate.ts",
    "composer:validate": "tsx scripts/validation/composer-validate.ts",
    "evidence:gen": "tsx scripts/docs/evidence-pages-gen.ts",
    "evidence:verify": "tsx scripts/docs/evidence-verify.ts",
    "nodes:report": "tsx scripts/validation/nodes-report.ts",
    "references:summary": "tsx scripts/docs/mapping-summary.ts",
    "debug:inspect": "npm run typecheck && npm run lint && npm test && npm run verify:contracts && tsx scripts/validation/debug-inspect.ts",
    "verify:contracts": "tsx scripts/validation/verify-contracts.ts",
    "verify": "npm run build && npm run notices:verify && npm run docs:links && npm run lint && npm test && npm run conditions:validate && npm run composer:validate && npm run evidence:verify && npm run verify:contracts",
    "check": "npm run verify",
    "clean:local": "rm -rf dist reports tsconfig.tsbuildinfo",
    "pages:build": "node scripts/deploy/build-pages.mjs",
    "pages:preview": "node scripts/deploy/preview-pages.mjs",
    "pages:verify": "node scripts/deploy/verify-pages-build.mjs",
    "release:alpha:local": "npm run audit:dependencies && npm run check",
    "release:alpha:checklist": "npm run clean:local && npm ci --ignore-scripts && npm rebuild esbuild && npm run release:alpha:local"
  },
  "dependencies": {
    "dompurify": "^3.4.13",
    "marked": "^18.0.10",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@types/node": "^25.5.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.1",
    "tsx": "^4.22.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.0.18"
  }
}
