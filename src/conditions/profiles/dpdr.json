{
  "id": "dpdr",
  "label": "Depersonalization / Derealization",
  "summary": "A metaphor of distance and 'behind glass': subtle ghosting, chroma drift, and gentle time/phase instability (with Reduced Motion support).",
  "framing": {
    "type": "metaphor",
    "disclaimer": "This is a metaphorical overlay for understanding and reflection. It does not diagnose or replicate clinical reality."
  },
  "experience_dimensions": [
    {
      "id": "derealization",
      "weight": 0.8
    },
    {
      "id": "depersonalization",
      "weight": 0.65
    },
    {
      "id": "time_dilation",
      "weight": 0.45
    }
  ],
  "safety": {
    "intensity_default": 0.3,
    "intensity_max": 0.58,
    "warnings": [
      "May feel disorienting for some. Enable Reduced Motion if needed.",
      "Keep Intensity low; Safe Mode recommended.",
      "Avoid flashing lights or rapid flicker; enable Reduced Motion if sensitive.",
      "Keep volume low; avoid headphones at high volume; you can mute audio at any time."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.62,
      "max_temporal_feedback": 0.12,
      "max_chroma": 0.1,
      "max_contrast": 0.25,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.12,
      "max_jitter": 0.05
    },
    "reduced_motion_policy": {
      "disable_nodes": [
        "temporal_smear",
        "feedback_loop",
        "pulse",
        "focus_jitter"
      ],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "reduced_motion",
        "type": "toggle",
        "label": "Reduced Motion"
      },
      {
        "id": "audio_enabled",
        "type": "toggle",
        "label": "Audio (optional)"
      },
      {
        "id": "chroma",
        "type": "slider",
        "label": "Chroma Drift",
        "min": 0,
        "max": 0.25,
        "step": 0.01,
        "target": "video.chroma_aberration.amount"
      }
    ]
  },
  "video_stack": [
    {
      "id": "time",
      "node": "temporal_smear",
      "params": {
        "decay": 0.95,
        "feedback": 0.08,
        "jitter": 0.03
      }
    },
    {
      "id": "vignette",
      "node": "vignette",
      "params": {
        "amount": 0.14,
        "softness": 0.9
      }
    },
    {
      "id": "chroma",
      "node": "chroma_aberration",
      "params": {
        "amount": 0.06
      }
    },
    {
      "id": "haze",
      "node": "haze",
      "params": {
        "amount": 0.12
      }
    },
    {
      "id": "grade",
      "node": "color_grade",
      "params": {
        "contrast": -0.05,
        "saturation": -0.1,
        "brightness": -0.01
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "master": {
      "volume": 0.18
    },
    "chain": [
      {
        "node": "flutter",
        "params": {
          "rate": 0.55,
          "depth": 0.05
        }
      },
      {
        "node": "lowpass",
        "params": {
          "cutoff": 3600,
          "q": 0.7
        }
      },
      {
        "node": "delay",
        "params": {
          "time": 0.18,
          "feedback": 0.06,
          "mix": 0.03
        }
      },
      {
        "node": "reverb",
        "params": {
          "mix": 0.06,
          "decay": 1.8
        }
      },
      {
        "node": "compressor_limiter",
        "params": {
          "threshold": -20,
          "ratio": 3,
          "attack": 0.02,
          "release": 0.3,
          "ceiling": -10
        }
      }
    ]
  },
  "reactive": {
    "analyser_to_params": [
      {
        "source": "rms",
        "target": "video.haze.amount",
        "scale": 0.15,
        "offset": 0.0,
        "smoothing": {
          "attack": 0.08,
          "release": 0.25
        },
        "clamp": [
          0.0,
          0.45
        ]
      },
      {
        "source": "rms",
        "target": "video.temporal_smear.feedback",
        "scale": 0.08,
        "offset": 0.08,
        "smoothing": {
          "attack": 0.1,
          "release": 0.35
        },
        "clamp": [
          0.06,
          0.2
        ]
      }
    ]
  },
  "references": {
    "dimensions": [
      "docs/references/dimensions/derealization.md",
      "docs/references/dimensions/depersonalization.md",
      "docs/references/dimensions/time_dilation.md"
    ]
  }
}
