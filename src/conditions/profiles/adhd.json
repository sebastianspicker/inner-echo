{
  "id": "adhd",
  "label": "ADHD (Attention Fragmentation / Overload)",
  "summary": "A metaphor of attention shifting and signal competition: moving salience anchors, small attention jumps, and detail gain.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "This is a metaphorical overlay for understanding and reflection. It does not diagnose or replicate clinical reality."
  },
  "experience_dimensions": [
    {
      "id": "attention_fragmentation",
      "weight": 0.85
    },
    {
      "id": "sensory_overload",
      "weight": 0.55
    },
    {
      "id": "hyperarousal",
      "weight": 0.35
    }
  ],
  "safety": {
    "intensity_default": 0.5,
    "intensity_max": 0.65,
    "warnings": [
      "If you feel overstimulated, reduce Intensity and enable Safe Mode.",
      "Reduced Motion is recommended for motion sensitivity.",
      "Audio is optional; keep volume low.",
      "Avoid flashing lights or rapid flicker; enable Reduced Motion if sensitive.",
      "Keep volume low; avoid headphones at high volume; you can mute audio at any time."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.65,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.12,
      "max_contrast": 0.2,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.18,
      "max_jitter": 0.06
    },
    "reduced_motion_policy": {
      "disable_nodes": [
        "temporal_smear",
        "feedback_loop",
        "pulse",
        "focus_jitter",
        "salience_competition"
      ],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "reduced_motion",
        "type": "toggle",
        "label": "Reduced Motion"
      },
      {
        "id": "audio_enabled",
        "type": "toggle",
        "label": "Audio (optional)"
      },
      {
        "id": "salience",
        "type": "slider",
        "label": "Competing Salience",
        "min": 0,
        "max": 0.3,
        "step": 0.01,
        "target": "video.salience_competition.amount"
      },
      {
        "id": "sharpen",
        "type": "slider",
        "label": "Detail Gain",
        "min": 0,
        "max": 0.2,
        "step": 0.01,
        "target": "video.edge_sharpen.amount"
      }
    ]
  },
  "video_stack": [
    {
      "id": "salience",
      "node": "salience_competition",
      "params": {
        "amount": 0.28,
        "marker_strength": 0.62,
        "shift": 0.055,
        "jump_rate": 1.7
      }
    },
    {
      "id": "focus",
      "node": "focus_jitter",
      "params": {
        "amount": 0.055,
        "smoothing": 0.78
      }
    },
    {
      "id": "edge",
      "node": "edge_sharpen",
      "params": {
        "amount": 0.12
      }
    },
    {
      "id": "grade",
      "node": "color_grade",
      "params": {
        "contrast": 0.08,
        "saturation": 0.02,
        "brightness": 0.02,
        "temperature": 0,
        "tint": 0
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "master": {
      "volume": 0.2
    },
    "chain": [
      {
        "node": "tremolo",
        "params": {
          "rate": 2.6,
          "depth": 0.08
        }
      },
      {
        "node": "highpass",
        "params": {
          "cutoff": 150,
          "q": 0.7
        }
      },
      {
        "node": "lowpass",
        "params": {
          "cutoff": 8500,
          "q": 0.7
        }
      },
      {
        "node": "noise_bed",
        "params": {
          "level": 0.018,
          "color": "pink"
        }
      },
      {
        "node": "compressor_limiter",
        "params": {
          "threshold": -22,
          "ratio": 4,
          "attack": 0.01,
          "release": 0.22,
          "ceiling": -10
        }
      }
    ]
  },
  "reactive": {
    "analyser_to_params": [
      {
        "source": "rms",
        "target": "video.salience_competition.amount",
        "scale": 0.08,
        "offset": 0,
        "smoothing": {
          "attack": 0.06,
          "release": 0.18
        },
        "clamp": [0.08, 0.3]
      },
      {
        "source": "rms",
        "target": "video.salience_competition.shift",
        "scale": 0.018,
        "offset": 0,
        "smoothing": {
          "attack": 0.06,
          "release": 0.2
        },
        "clamp": [0.015, 0.08]
      }
    ]
  },
  "references": {
    "dimensions": [
      "docs/references/dimensions/attention_fragmentation.md",
      "docs/references/dimensions/sensory_overload.md",
      "docs/references/dimensions/hyperarousal.md"
    ]
  }
}
