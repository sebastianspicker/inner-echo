{
  "id": "ocd",
  "label": "OCD (Intrusion + Compulsive Loop)",
  "summary": "A metaphor of sticky loops and repeated checking pressure—subtle feedback/echo cues with strict safety caps.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "This is a metaphorical overlay for understanding and reflection. It does not diagnose or replicate clinical reality."
  },
  "experience_dimensions": [
    {
      "id": "rumination_loop",
      "weight": 0.75
    },
    {
      "id": "intrusion",
      "weight": 0.55
    },
    {
      "id": "compulsive_loop",
      "weight": 0.6
    }
  ],
  "safety": {
    "intensity_default": 0.34,
    "intensity_max": 0.66,
    "warnings": [
      "Loops are subtle, but may feel 'sticky' or uncomfortable.",
      "Use Safe Mode; disable Audio if repetitive cues feel unpleasant.",
      "Avoid flashing lights or rapid flicker; enable Reduced Motion if sensitive.",
      "Keep volume low; avoid headphones at high volume; you can mute audio at any time."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.65,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.35,
      "max_contrast": 0.25,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.25,
      "max_jitter": 0.06
    },
    "reduced_motion_policy": {
      "disable_nodes": [
        "temporal_smear",
        "feedback_loop",
        "pulse",
        "focus_jitter"
      ],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "reduced_motion",
        "type": "toggle",
        "label": "Reduced Motion"
      },
      {
        "id": "audio_enabled",
        "type": "toggle",
        "label": "Audio (optional)"
      },
      {
        "id": "loop_strength",
        "type": "slider",
        "label": "Loop Strength",
        "min": 0.05,
        "max": 0.25,
        "step": 0.01,
        "target": "video.feedback_loop.feedback"
      }
    ]
  },
  "video_stack": [
    {
      "id": "loop",
      "node": "feedback_loop",
      "params": {
        "decay": 0.94,
        "feedback": 0.14,
        "jitter": 0.03
      }
    },
    {
      "id": "grid",
      "node": "grid_hint",
      "params": {
        "amount": 0.06
      }
    },
    {
      "id": "intrusions",
      "node": "interference",
      "params": {
        "amount": 0.08,
        "banding": 0.05,
        "smoothing": 0.92,
        "burst_probability": 0.06,
        "burst_duration_ms": 280,
        "burst_min_gap_ms": 1100
      }
    },
    {
      "id": "grain",
      "node": "grain",
      "params": {
        "amount": 0.14,
        "scale": 1.3,
        "speed": 0.06
      }
    },
    {
      "id": "vignette",
      "node": "vignette",
      "params": {
        "amount": 0.16,
        "softness": 0.9
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "master": {
      "volume": 0.18
    },
    "chain": [
      {
        "node": "delay",
        "params": {
          "time": 0.16,
          "feedback": 0.1,
          "mix": 0.05
        }
      },
      {
        "node": "lowpass",
        "params": {
          "cutoff": 4200,
          "q": 0.7
        }
      },
      {
        "node": "tremolo",
        "params": {
          "rate": 0.7,
          "depth": 0.08
        }
      },
      {
        "node": "compressor_limiter",
        "params": {
          "threshold": -20,
          "ratio": 3,
          "attack": 0.02,
          "release": 0.25,
          "ceiling": -10
        }
      }
    ]
  },
  "reactive": {
    "analyser_to_params": [
      {
        "source": "rms",
        "target": "video.grain.amount",
        "scale": 0.15,
        "offset": 0.0,
        "smoothing": {
          "attack": 0.08,
          "release": 0.25
        },
        "clamp": [
          0.0,
          0.45
        ]
      },
      {
        "source": "rms",
        "target": "video.feedback_loop.feedback",
        "scale": 0.1,
        "offset": 0.08,
        "smoothing": {
          "attack": 0.12,
          "release": 0.35
        },
        "clamp": [
          0.06,
          0.22
        ]
      }
    ]
  },
  "references": {
    "dimensions": [
      "docs/references/dimensions/rumination_loop.md",
      "docs/references/dimensions/intrusion.md",
      "docs/references/dimensions/compulsive_loop.md"
    ]
  }
}

