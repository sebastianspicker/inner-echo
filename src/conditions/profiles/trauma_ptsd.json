{
  "id": "trauma_ptsd",
  "label": "Trauma / PTSD (Hyperarousal + Intrusion)",
  "summary": "A metaphor of elevated alertness with abstract interference intrusions. No graphic content—only signal-like textures.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "This is a metaphorical overlay for understanding and reflection. It does not diagnose or replicate clinical reality."
  },
  "experience_dimensions": [
    {
      "id": "hyperarousal",
      "weight": 0.8
    },
    {
      "id": "hypervigilance",
      "weight": 0.6
    },
    {
      "id": "intrusion",
      "weight": 0.55
    }
  ],
  "safety": {
    "intensity_default": 0.3,
    "intensity_max": 0.62,
    "warnings": [
      "May be activating. Use Safe Mode and keep Intensity low.",
      "No sudden jump-scares, but interference may still feel unpleasant for some.",
      "Audio is optional; keep volume low.",
      "Avoid flashing lights or rapid flicker; enable Reduced Motion if sensitive.",
      "Keep volume low; avoid headphones at high volume; you can mute audio at any time."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.62,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.35,
      "max_contrast": 0.25,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.25,
      "max_jitter": 0.06
    },
    "reduced_motion_policy": {
      "disable_nodes": [
        "temporal_smear",
        "feedback_loop",
        "pulse",
        "focus_jitter"
      ],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "reduced_motion",
        "type": "toggle",
        "label": "Reduced Motion"
      },
      {
        "id": "audio_enabled",
        "type": "toggle",
        "label": "Audio (optional)"
      },
      {
        "id": "interference",
        "type": "slider",
        "label": "Interference",
        "min": 0,
        "max": 0.2,
        "step": 0.01,
        "target": "video.interference.amount"
      }
    ]
  },
  "video_stack": [
    {
      "id": "grain",
      "node": "grain",
      "params": {
        "amount": 0.18,
        "scale": 1.25,
        "speed": 0.08
      }
    },
    {
      "id": "sharpen",
      "node": "edge_sharpen",
      "params": {
        "amount": 0.07
      }
    },
    {
      "id": "vignette",
      "node": "vignette",
      "params": {
        "amount": 0.22,
        "softness": 0.82
      }
    },
    {
      "id": "intrusions",
      "node": "interference",
      "params": {
        "amount": 0.1,
        "banding": 0.06,
        "smoothing": 0.92,
        "burst_probability": 0.08,
        "burst_duration_ms": 350,
        "burst_min_gap_ms": 900
      }
    },
    {
      "id": "grade",
      "node": "color_grade",
      "params": {
        "contrast": 0.06,
        "saturation": -0.04,
        "brightness": 0.0
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "master": {
      "volume": 0.2
    },
    "chain": [
      {
        "node": "noise_bed",
        "params": {
          "level": 0.025,
          "color": "pink"
        }
      },
      {
        "node": "highpass",
        "params": {
          "cutoff": 170,
          "q": 0.7
        }
      },
      {
        "node": "tremolo",
        "params": {
          "rate": 0.65,
          "depth": 0.08
        }
      },
      {
        "node": "delay",
        "params": {
          "time": 0.12,
          "feedback": 0.05,
          "mix": 0.03
        }
      },
      {
        "node": "compressor_limiter",
        "params": {
          "threshold": -22,
          "ratio": 4,
          "attack": 0.015,
          "release": 0.25,
          "ceiling": -8
        }
      }
    ]
  },
  "reactive": {
    "analyser_to_params": [
      {
        "source": "rms",
        "target": "video.grain.amount",
        "scale": 0.15,
        "offset": 0.0,
        "smoothing": {
          "attack": 0.08,
          "release": 0.25
        },
        "clamp": [
          0.0,
          0.45
        ]
      },
      {
        "source": "rms",
        "target": "video.interference.amount",
        "scale": 0.12,
        "offset": 0.02,
        "smoothing": {
          "attack": 0.05,
          "release": 0.2
        },
        "clamp": [
          0.0,
          0.18
        ]
      }
    ]
  },
  "references": {
    "dimensions": [
      "docs/references/dimensions/hyperarousal.md",
      "docs/references/dimensions/hypervigilance.md",
      "docs/references/dimensions/intrusion.md"
    ]
  }
}

