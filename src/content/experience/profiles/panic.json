{
  "id": "panic",
  "label": "Panic-related alarm",
  "summary": "Sudden visual waves rise, crest and release, narrowing and muffling the scene at the crest while a thin bed dulls and reopens. An artistic interpretation of reported surges; experiences of panic vary widely.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "An adjustable artistic interpretation of selected reported experiences. It does not portray a whole condition, predict an individual experience, or reproduce clinical perception. Visual and audio settings are design choices, not medically validated signals."
  },
  "experience_dimensions": [
    { "id": "panic_peaks", "weight": 0.9 },
    { "id": "hyperarousal", "weight": 0.7 }
  ],
  "safety": {
    "intensity_default": 0.5,
    "intensity_max": 1,
    "warnings": [
      "Start with low intensity and volume; sound is optional.",
      "Use Reduced Motion for a steadier image. Stop Everything is always available."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.75,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.12,
      "max_contrast": 0.22,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -8,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.18,
      "max_jitter": 0.06,
      "max_pulse_depth": 0.14
    },
    "reduced_motion_policy": {
      "disable_nodes": [
        "temporal_smear",
        "feedback_loop",
        "pulse",
        "focus_jitter",
        "somatic_pulse"
      ],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      { "id": "safe_mode", "type": "toggle", "label": "Safe Mode" },
      { "id": "reduced_motion", "type": "toggle", "label": "Reduced Motion" },
      { "id": "audio_enabled", "type": "toggle", "label": "Audio (optional)" },
      {
        "id": "pulse_depth",
        "type": "slider",
        "label": "Visual wave depth",
        "min": 0,
        "max": 0.18,
        "step": 0.01,
        "target": "video.somatic_pulse.depth"
      },
      {
        "id": "pulse_rate",
        "type": "slider",
        "label": "Visual wave speed",
        "min": 0.15,
        "max": 0.6,
        "step": 0.01,
        "target": "video.somatic_pulse.rate"
      },
      {
        "id": "surge",
        "type": "slider",
        "label": "Surge strength",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "target": "video.somatic_pulse.surge"
      }
    ]
  },
  "video_stack": [
    {
      "id": "body_wave",
      "node": "somatic_pulse",
      "params": {
        "depth": 0.16,
        "rate": 0.28,
        "smoothing": 0.9,
        "tunnel": 0.55,
        "blur": 0.3,
        "surge": 0.7,
        "surge_interval": 12
      }
    },
    { "id": "vignette", "node": "vignette", "params": { "amount": 0.3, "softness": 0.85 } },
    {
      "id": "grade",
      "node": "color_grade",
      "params": {
        "contrast": 0.1,
        "saturation": -0.12,
        "brightness": -0.02,
        "temperature": 0,
        "tint": 0
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "synth": {
      "frequency": 196,
      "detune": 5,
      "waveform": "triangle",
      "brightness": 0.5,
      "swell_interval": 0
    },
    "master": { "volume": 0.3 },
    "chain": [
      { "node": "noise_bed", "params": { "level": 0.035, "color": "pink" } },
      {
        "node": "lowpass",
        "params": { "cutoff": 2600, "q": 0.8, "sweep_rate": 0.28, "sweep_depth": 1.6 }
      },
      { "node": "reverb", "params": { "mix": 0.12, "decay": 1.4 } },
      {
        "node": "compressor_limiter",
        "params": { "threshold": -24, "ratio": 5, "attack": 0.008, "release": 0.2, "ceiling": -8 }
      }
    ]
  },
  "reactive": { "analyser_to_params": [] },
  "references": {
    "dimensions": [
      "docs/references/dimensions/panic_peaks.md",
      "docs/references/dimensions/hyperarousal.md"
    ]
  }
}
