{
  "id": "anxiety",
  "label": "Anxiety-related tension and worry",
  "summary": "Gentle focus narrowing, restrained detail and a quiet sound bed offer an artistic interpretation of tension and worry. These experiences vary; anxiety does not have a single visual or auditory form.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "An adjustable artistic interpretation of selected reported experiences. It does not portray a whole condition, predict an individual experience, or reproduce clinical perception. Visual and audio settings are design choices, not medically validated signals."
  },
  "experience_dimensions": [
    {
      "id": "hyperarousal",
      "weight": 0.8
    },
    {
      "id": "hypervigilance",
      "weight": 0.7
    },
    {
      "id": "rumination_loop",
      "weight": 0.3
    }
  ],
  "safety": {
    "intensity_default": 0.35,
    "intensity_max": 0.65,
    "warnings": [
      "Start with low intensity and volume; sound is optional.",
      "Use Reduced Motion for a steadier image. Stop Everything is always available."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.65,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.12,
      "max_contrast": 0.25,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.18,
      "max_jitter": 0.06
    },
    "reduced_motion_policy": {
      "disable_nodes": ["temporal_smear", "feedback_loop", "pulse", "focus_jitter"],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "reduced_motion",
        "type": "toggle",
        "label": "Reduced Motion"
      },
      {
        "id": "audio_enabled",
        "type": "toggle",
        "label": "Audio (optional)"
      },
      {
        "id": "gaze_tunnel",
        "type": "slider",
        "label": "Focus Narrowing",
        "min": 0,
        "max": 0.85,
        "step": 0.01,
        "target": "video.gaze_tunnel.amount"
      },
      {
        "id": "edge_salience",
        "type": "slider",
        "label": "Edge Salience",
        "min": 0,
        "max": 0.35,
        "step": 0.01,
        "target": "video.gaze_tunnel.edge_gain"
      }
    ]
  },
  "video_stack": [
    {
      "id": "gaze",
      "node": "gaze_tunnel",
      "params": {
        "amount": 0.3,
        "radius": 0.48,
        "edge_gain": 0.1,
        "desaturate": 0.06
      }
    },
    {
      "id": "sharpen",
      "node": "edge_sharpen",
      "params": {
        "amount": 0.1
      }
    },
    {
      "id": "grain",
      "node": "grain",
      "params": {
        "amount": 0.015,
        "scale": 1.25,
        "speed": 0.025
      }
    },
    {
      "id": "grade",
      "node": "color_grade",
      "params": {
        "contrast": 0.1,
        "saturation": -0.02,
        "brightness": 0.01,
        "temperature": 0,
        "tint": 0
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "master": {
      "volume": 0.18
    },
    "chain": [
      {
        "node": "noise_bed",
        "params": {
          "level": 0.02,
          "color": "pink"
        }
      },
      {
        "node": "highpass",
        "params": {
          "cutoff": 160,
          "q": 0.7
        }
      },
      {
        "node": "tremolo",
        "params": {
          "rate": 0.5,
          "depth": 0.035
        }
      },
      {
        "node": "compressor_limiter",
        "params": {
          "threshold": -20,
          "ratio": 3,
          "attack": 0.02,
          "release": 0.25,
          "ceiling": -6
        }
      }
    ]
  },
  "reactive": {
    "analyser_to_params": []
  },
  "references": {
    "dimensions": [
      "docs/references/dimensions/hyperarousal.md",
      "docs/references/dimensions/hypervigilance.md",
      "docs/references/dimensions/rumination_loop.md"
    ]
  }
}
