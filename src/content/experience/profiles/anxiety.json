{
  "id": "anxiety",
  "label": "Anxiety (Generalized / Social)",
  "summary": "A metaphor of heightened tension and scanning attention, expressed as a strong gaze tunnel, edge salience, and minimal texture.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "This is a metaphorical overlay for understanding and reflection. It does not diagnose or replicate clinical reality."
  },
  "experience_dimensions": [
    {
      "id": "hyperarousal",
      "weight": 0.8
    },
    {
      "id": "hypervigilance",
      "weight": 0.7
    },
    {
      "id": "rumination_loop",
      "weight": 0.3
    }
  ],
  "safety": {
    "intensity_default": 0.5,
    "intensity_max": 0.65,
    "warnings": [
      "May feel uncomfortable for some users. Use Safe Mode or stop at any time.",
      "If you are motion-sensitive, enable Reduced Motion.",
      "Audio is optional; keep volume low.",
      "Avoid flashing lights or rapid flicker; enable Reduced Motion if sensitive.",
      "Keep volume low; avoid headphones at high volume; you can mute audio at any time."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.65,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.12,
      "max_contrast": 0.25,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.18,
      "max_jitter": 0.06
    },
    "reduced_motion_policy": {
      "disable_nodes": ["temporal_smear", "feedback_loop", "pulse", "focus_jitter"],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "reduced_motion",
        "type": "toggle",
        "label": "Reduced Motion"
      },
      {
        "id": "audio_enabled",
        "type": "toggle",
        "label": "Audio (optional)"
      },
      {
        "id": "gaze_tunnel",
        "type": "slider",
        "label": "Focus Narrowing",
        "min": 0,
        "max": 0.85,
        "step": 0.01,
        "target": "video.gaze_tunnel.amount"
      },
      {
        "id": "edge_salience",
        "type": "slider",
        "label": "Edge Salience",
        "min": 0,
        "max": 0.35,
        "step": 0.01,
        "target": "video.gaze_tunnel.edge_gain"
      }
    ]
  },
  "video_stack": [
    {
      "id": "gaze",
      "node": "gaze_tunnel",
      "params": {
        "amount": 0.68,
        "radius": 0.36,
        "edge_gain": 0.22,
        "desaturate": 0.18
      }
    },
    {
      "id": "sharpen",
      "node": "edge_sharpen",
      "params": {
        "amount": 0.1
      }
    },
    {
      "id": "grain",
      "node": "grain",
      "params": {
        "amount": 0.015,
        "scale": 1.25,
        "speed": 0.025
      }
    },
    {
      "id": "grade",
      "node": "color_grade",
      "params": {
        "contrast": 0.1,
        "saturation": -0.02,
        "brightness": 0.01,
        "temperature": 0,
        "tint": 0
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "master": {
      "volume": 0.22
    },
    "chain": [
      {
        "node": "noise_bed",
        "params": {
          "level": 0.02,
          "color": "pink"
        }
      },
      {
        "node": "highpass",
        "params": {
          "cutoff": 160,
          "q": 0.7
        }
      },
      {
        "node": "tremolo",
        "params": {
          "rate": 1.1,
          "depth": 0.07
        }
      },
      {
        "node": "compressor_limiter",
        "params": {
          "threshold": -20,
          "ratio": 3,
          "attack": 0.02,
          "release": 0.25,
          "ceiling": -6
        }
      }
    ]
  },
  "reactive": {
    "analyser_to_params": [
      {
        "source": "rms",
        "target": "video.gaze_tunnel.amount",
        "scale": 0.08,
        "offset": 0,
        "smoothing": {
          "attack": 0.1,
          "release": 0.3
        },
        "clamp": [0.2, 0.82]
      },
      {
        "source": "rms",
        "target": "video.gaze_tunnel.edge_gain",
        "scale": 0.07,
        "offset": 0,
        "smoothing": {
          "attack": 0.12,
          "release": 0.35
        },
        "clamp": [0.05, 0.32]
      }
    ]
  },
  "references": {
    "dimensions": [
      "docs/references/dimensions/hyperarousal.md",
      "docs/references/dimensions/hypervigilance.md",
      "docs/references/dimensions/rumination_loop.md"
    ]
  }
}
