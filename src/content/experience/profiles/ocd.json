{
  "id": "ocd",
  "label": "OCD-related intrusive thoughts and repetition",
  "summary": "An image that keeps resurfacing, restrained abstract intrusions and a quiet repeating echo offer an artistic interpretation of unwanted recurrence. These experiences vary; OCD does not have a single visual or auditory form.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "An adjustable artistic interpretation of selected reported experiences. It does not portray a whole condition, predict an individual experience, or reproduce clinical perception. Visual and audio settings are design choices, not medically validated signals."
  },
  "experience_dimensions": [
    {
      "id": "intrusion",
      "weight": 0.55
    },
    {
      "id": "compulsive_loop",
      "weight": 0.6
    }
  ],
  "safety": {
    "intensity_default": 0.5,
    "intensity_max": 1,
    "warnings": [
      "Start with low intensity and volume; sound is optional.",
      "Use Reduced Motion for a steadier image. Stop Everything is always available."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.8,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.12,
      "max_contrast": 0.25,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.18,
      "max_jitter": 0.06
    },
    "reduced_motion_policy": {
      "disable_nodes": ["temporal_smear", "feedback_loop", "pulse", "focus_jitter", "interference"],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "reduced_motion",
        "type": "toggle",
        "label": "Reduced Motion"
      },
      {
        "id": "audio_enabled",
        "type": "toggle",
        "label": "Audio (optional)"
      },
      {
        "id": "loop_strength",
        "type": "slider",
        "label": "Image persistence",
        "min": 0,
        "max": 0.18,
        "step": 0.01,
        "target": "video.feedback_loop.feedback"
      },
      {
        "id": "intrusion_texture",
        "type": "slider",
        "label": "Intrusion texture",
        "min": 0,
        "max": 0.2,
        "step": 0.01,
        "target": "video.interference.amount"
      }
    ]
  },
  "video_stack": [
    {
      "id": "loop",
      "node": "feedback_loop",
      "params": {
        "decay": 0.97,
        "feedback": 0.18,
        "jitter": 0
      }
    },
    {
      "id": "interference",
      "node": "interference",
      "params": {
        "amount": 0.14,
        "banding": 0.04,
        "smoothing": 0.93,
        "burst_probability": 0.14,
        "burst_duration_ms": 320,
        "burst_min_gap_ms": 3000
      }
    },
    {
      "id": "vignette",
      "node": "vignette",
      "params": {
        "amount": 0.28,
        "softness": 0.85
      }
    },
    {
      "id": "grade",
      "node": "color_grade",
      "params": {
        "contrast": 0.06,
        "saturation": -0.06,
        "brightness": 0,
        "temperature": 0,
        "tint": 0
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "synth": {
      "frequency": 233.1,
      "detune": 4,
      "waveform": "triangle",
      "brightness": 0.55,
      "spread": 0.35,
      "swell_interval": 8
    },
    "master": {
      "volume": 0.5
    },
    "chain": [
      {
        "node": "delay",
        "params": {
          "time": 0.28,
          "feedback": 0.35,
          "mix": 0.25
        }
      },
      {
        "node": "lowpass",
        "params": {
          "cutoff": 2800,
          "q": 0.8
        }
      },
      {
        "node": "compressor_limiter",
        "params": {
          "threshold": -22,
          "ratio": 4,
          "attack": 0.015,
          "release": 0.25,
          "ceiling": -6
        }
      }
    ]
  },
  "reactive": {
    "analyser_to_params": []
  },
  "references": {
    "dimensions": [
      "docs/references/dimensions/intrusion.md",
      "docs/references/dimensions/compulsive_loop.md"
    ]
  }
}
