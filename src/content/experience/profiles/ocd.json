{
  "id": "ocd",
  "label": "OCD-related intrusive thoughts and repetition",
  "summary": "Subtle image persistence and a quiet echo offer an artistic interpretation of unwanted recurrence. OCD can involve varied intrusive thoughts and mental or physical compulsions; this collection does not equate it with tidiness or order.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "An adjustable artistic interpretation of selected reported experiences. It does not portray a whole condition, predict an individual experience, or reproduce clinical perception. Visual and audio settings are design choices, not medically validated signals."
  },
  "experience_dimensions": [
    {
      "id": "intrusion",
      "weight": 0.55
    },
    {
      "id": "compulsive_loop",
      "weight": 0.6
    }
  ],
  "safety": {
    "intensity_default": 0.35,
    "intensity_max": 0.66,
    "warnings": [
      "Start with low intensity and volume; sound is optional.",
      "Use Reduced Motion for a steadier image. Stop Everything is always available."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.65,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.12,
      "max_contrast": 0.25,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.18,
      "max_jitter": 0.06
    },
    "reduced_motion_policy": {
      "disable_nodes": ["temporal_smear", "feedback_loop", "pulse", "focus_jitter"],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "reduced_motion",
        "type": "toggle",
        "label": "Reduced Motion"
      },
      {
        "id": "audio_enabled",
        "type": "toggle",
        "label": "Audio (optional)"
      },
      {
        "id": "loop_strength",
        "type": "slider",
        "label": "Image persistence",
        "min": 0,
        "max": 0.18,
        "step": 0.01,
        "target": "video.feedback_loop.feedback"
      }
    ]
  },
  "video_stack": [
    {
      "id": "loop",
      "node": "feedback_loop",
      "params": {
        "decay": 0.96,
        "feedback": 0.12,
        "jitter": 0
      }
    },
    {
      "id": "vignette",
      "node": "vignette",
      "params": {
        "amount": 0.14,
        "softness": 0.9
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "master": {
      "volume": 0.18
    },
    "chain": [
      {
        "node": "delay",
        "params": {
          "time": 0.16,
          "feedback": 0.06,
          "mix": 0.035
        }
      },
      {
        "node": "lowpass",
        "params": {
          "cutoff": 4200,
          "q": 0.7
        }
      },
      {
        "node": "compressor_limiter",
        "params": {
          "threshold": -20,
          "ratio": 3,
          "attack": 0.02,
          "release": 0.25,
          "ceiling": -10
        }
      }
    ]
  },
  "reactive": {
    "analyser_to_params": []
  },
  "references": {
    "dimensions": [
      "docs/references/dimensions/intrusion.md",
      "docs/references/dimensions/compulsive_loop.md"
    ]
  }
}
