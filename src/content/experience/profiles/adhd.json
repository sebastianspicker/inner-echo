{
  "id": "adhd",
  "label": "ADHD-related attention experiences",
  "summary": "Gently shifting areas of detail and a steady optional sound bed offer an artistic interpretation of competing attention. Attention and sensory experiences vary; this is one adjustable interpretation, not a depiction of everyone with ADHD.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "An adjustable artistic interpretation of selected reported experiences. It does not portray a whole condition, predict an individual experience, or reproduce clinical perception. Visual and audio settings are design choices, not medically validated signals."
  },
  "experience_dimensions": [
    {
      "id": "attention_fragmentation",
      "weight": 0.85
    }
  ],
  "safety": {
    "intensity_default": 0.35,
    "intensity_max": 0.65,
    "warnings": [
      "Start with low intensity and volume; sound is optional.",
      "Use Reduced Motion for a steadier image. Stop Everything is always available."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.65,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.12,
      "max_contrast": 0.2,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.18,
      "max_jitter": 0.06
    },
    "reduced_motion_policy": {
      "disable_nodes": [
        "temporal_smear",
        "feedback_loop",
        "pulse",
        "focus_jitter",
        "salience_competition"
      ],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "reduced_motion",
        "type": "toggle",
        "label": "Reduced Motion"
      },
      {
        "id": "audio_enabled",
        "type": "toggle",
        "label": "Audio (optional)"
      },
      {
        "id": "salience",
        "type": "slider",
        "label": "Competing Salience",
        "min": 0,
        "max": 0.3,
        "step": 0.01,
        "target": "video.salience_competition.amount"
      },
      {
        "id": "sharpen",
        "type": "slider",
        "label": "Detail Gain",
        "min": 0,
        "max": 0.2,
        "step": 0.01,
        "target": "video.edge_sharpen.amount"
      }
    ]
  },
  "video_stack": [
    {
      "id": "salience",
      "node": "salience_competition",
      "params": {
        "amount": 0.16,
        "marker_strength": 0.35,
        "shift": 0,
        "jump_rate": 0.35
      }
    },
    {
      "id": "edge",
      "node": "edge_sharpen",
      "params": {
        "amount": 0.12
      }
    },
    {
      "id": "grade",
      "node": "color_grade",
      "params": {
        "contrast": 0.08,
        "saturation": 0.02,
        "brightness": 0.02,
        "temperature": 0,
        "tint": 0
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "master": {
      "volume": 0.18
    },
    "chain": [
      {
        "node": "highpass",
        "params": {
          "cutoff": 150,
          "q": 0.7
        }
      },
      {
        "node": "lowpass",
        "params": {
          "cutoff": 8500,
          "q": 0.7
        }
      },
      {
        "node": "noise_bed",
        "params": {
          "level": 0.018,
          "color": "pink"
        }
      },
      {
        "node": "compressor_limiter",
        "params": {
          "threshold": -22,
          "ratio": 4,
          "attack": 0.01,
          "release": 0.22,
          "ceiling": -10
        }
      }
    ]
  },
  "reactive": {
    "analyser_to_params": []
  },
  "references": {
    "dimensions": ["docs/references/dimensions/attention_fragmentation.md"]
  }
}
