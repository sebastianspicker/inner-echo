{
  "id": "adhd",
  "label": "ADHD-related attention experiences",
  "summary": "A spotlight of attention that will not stay put, slightly vivid busy micro-texture and a brighter, busier bed whose focus wanders offer an artistic interpretation of shifting attention. These experiences vary; ADHD does not have a single visual or auditory form.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "An adjustable artistic interpretation of selected reported experiences. It does not portray a whole condition, predict an individual experience, or reproduce clinical perception. Visual and audio settings are design choices, not medically validated signals."
  },
  "experience_dimensions": [{ "id": "attention_fragmentation", "weight": 0.85 }],
  "safety": {
    "intensity_default": 0.5,
    "intensity_max": 1,
    "warnings": [
      "Start with low intensity and volume; sound is optional.",
      "Use Reduced Motion for a steadier image. Stop Everything is always available."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.8,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.12,
      "max_contrast": 0.2,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.18,
      "max_jitter": 0.06
    },
    "reduced_motion_policy": {
      "disable_nodes": [
        "temporal_smear",
        "feedback_loop",
        "pulse",
        "focus_jitter",
        "salience_competition"
      ],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      { "id": "safe_mode", "type": "toggle", "label": "Safe Mode" },
      { "id": "reduced_motion", "type": "toggle", "label": "Reduced Motion" },
      { "id": "audio_enabled", "type": "toggle", "label": "Audio (optional)" },
      {
        "id": "salience",
        "type": "slider",
        "label": "Competing salience",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "target": "video.salience_competition.amount"
      },
      {
        "id": "shift_rate",
        "type": "slider",
        "label": "Shift rate",
        "min": 0.1,
        "max": 1.5,
        "step": 0.01,
        "target": "video.salience_competition.jump_rate"
      },
      {
        "id": "detail_gain",
        "type": "slider",
        "label": "Detail gain",
        "min": 0,
        "max": 1,
        "step": 0.01,
        "target": "video.edge_sharpen.amount"
      }
    ]
  },
  "video_stack": [
    {
      "id": "salience",
      "node": "salience_competition",
      "params": { "amount": 0.7, "marker_strength": 0.5, "shift": 0.03, "jump_rate": 0.4 }
    },
    { "id": "edge", "node": "edge_sharpen", "params": { "amount": 0.25 } },
    { "id": "grain", "node": "grain", "params": { "amount": 0.05, "scale": 1, "speed": 0.12 } },
    {
      "id": "grade",
      "node": "color_grade",
      "params": {
        "contrast": 0.08,
        "saturation": 0.08,
        "brightness": 0.02,
        "temperature": 0,
        "tint": 0
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "synth": {
      "frequency": 329.6,
      "detune": 5,
      "waveform": "triangle",
      "brightness": 0.8,
      "swell_interval": 6
    },
    "master": { "volume": 0.3 },
    "chain": [
      { "node": "noise_bed", "params": { "level": 0.04, "color": "pink" } },
      { "node": "highpass", "params": { "cutoff": 180, "q": 0.7 } },
      {
        "node": "lowpass",
        "params": { "cutoff": 4200, "q": 0.8, "sweep_rate": 0.11, "sweep_depth": 1.3 }
      },
      {
        "node": "compressor_limiter",
        "params": { "threshold": -24, "ratio": 5, "attack": 0.01, "release": 0.22, "ceiling": -10 }
      }
    ]
  },
  "reactive": { "analyser_to_params": [] },
  "references": { "dimensions": ["docs/references/dimensions/attention_fragmentation.md"] }
}
