{
  "id": "depression",
  "label": "Depression-related energy and concentration",
  "summary": "Mild tonal softening and a quiet, filtered sound bed offer an artistic interpretation of reduced energy or concentration. Depression varies between people and does not mean seeing a grey or blurred world.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "An adjustable artistic interpretation of selected reported experiences. It does not portray a whole condition, predict an individual experience, or reproduce clinical perception. Visual and audio settings are design choices, not medically validated signals."
  },
  "experience_dimensions": [
    {
      "id": "emotional_numbing",
      "weight": 0.85
    },
    {
      "id": "cognitive_fog",
      "weight": 0.6
    },
    {
      "id": "time_dilation",
      "weight": 0.35
    }
  ],
  "safety": {
    "intensity_default": 0.35,
    "intensity_max": 0.7,
    "warnings": [
      "Start with low intensity and volume; sound is optional.",
      "Use Reduced Motion for a steadier image. Stop Everything is always available."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.65,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.12,
      "max_contrast": 0.25,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.18,
      "max_jitter": 0.06
    },
    "reduced_motion_policy": {
      "disable_nodes": ["temporal_smear", "feedback_loop", "pulse", "focus_jitter"],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "reduced_motion",
        "type": "toggle",
        "label": "Reduced Motion"
      },
      {
        "id": "audio_enabled",
        "type": "toggle",
        "label": "Audio (optional)"
      },
      {
        "id": "saturation",
        "type": "slider",
        "label": "Visual tone",
        "min": -0.6,
        "max": 0,
        "step": 0.01,
        "target": "video.color_grade.saturation"
      },
      {
        "id": "blur_amount",
        "type": "slider",
        "label": "Softness",
        "min": 0,
        "max": 0.35,
        "step": 0.01,
        "target": "video.soft_blur.amount"
      }
    ]
  },
  "video_stack": [
    {
      "id": "grade",
      "node": "color_grade",
      "params": {
        "contrast": -0.08,
        "saturation": -0.12,
        "brightness": 0,
        "temperature": 0,
        "tint": 0
      }
    },
    {
      "id": "haze",
      "node": "haze",
      "params": {
        "amount": 0.08
      }
    },
    {
      "id": "blur",
      "node": "soft_blur",
      "params": {
        "amount": 0.08
      }
    },
    {
      "id": "grain",
      "node": "grain",
      "params": {
        "amount": 0.012,
        "scale": 1.4,
        "speed": 0.015
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "master": {
      "volume": 0.18
    },
    "chain": [
      {
        "node": "lowpass",
        "params": {
          "cutoff": 3400,
          "q": 0.7
        }
      },
      {
        "node": "noise_bed",
        "params": {
          "level": 0.018,
          "color": "brown"
        }
      },
      {
        "node": "reverb",
        "params": {
          "mix": 0.055,
          "decay": 1.9
        }
      },
      {
        "node": "compressor_limiter",
        "params": {
          "threshold": -20,
          "ratio": 3,
          "attack": 0.02,
          "release": 0.3,
          "ceiling": -10
        }
      }
    ]
  },
  "reactive": {
    "analyser_to_params": []
  },
  "references": {
    "dimensions": [
      "docs/references/dimensions/emotional_numbing.md",
      "docs/references/dimensions/cognitive_fog.md",
      "docs/references/dimensions/time_dilation.md"
    ]
  }
}
