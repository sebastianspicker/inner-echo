{
  "id": "trauma_ptsd",
  "label": "PTSD-related experiences",
  "summary": "Fine static texture and restrained detail offer an artistic interpretation of heightened alertness. This collection does not replay memories or represent the full range of PTSD experiences.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "An adjustable artistic interpretation of selected reported experiences. It does not portray a whole condition, predict an individual experience, or reproduce clinical perception. Visual and audio settings are design choices, not medically validated signals."
  },
  "experience_dimensions": [
    {
      "id": "hyperarousal",
      "weight": 0.8
    },
    {
      "id": "hypervigilance",
      "weight": 0.6
    },
    {
      "id": "intrusion",
      "weight": 0.55
    }
  ],
  "safety": {
    "intensity_default": 0.35,
    "intensity_max": 0.62,
    "warnings": [
      "Start with low intensity and volume; sound is optional.",
      "Use Reduced Motion for a steadier image. Stop Everything is always available."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.62,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.12,
      "max_contrast": 0.25,
      "no_strobe": true,
      "max_flash_hz": 3,
      "max_luminance_delta_per_frame": 0.25,
      "audio_ceiling_dbfs": -6,
      "max_tremolo_rate_hz": 4,
      "max_tremolo_depth": 0.15,
      "max_noise_level": 0.08,
      "max_feedback": 0.18,
      "max_jitter": 0.06
    },
    "reduced_motion_policy": {
      "disable_nodes": [
        "temporal_smear",
        "feedback_loop",
        "pulse",
        "focus_jitter",
        "intrusion_burst"
      ],
      "note": "Reduced Motion removes time-based feedback/jitter nodes and keeps a calmer static overlay."
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "reduced_motion",
        "type": "toggle",
        "label": "Reduced Motion"
      },
      {
        "id": "audio_enabled",
        "type": "toggle",
        "label": "Audio (optional)"
      },
      {
        "id": "intrusion_burst",
        "type": "slider",
        "label": "Texture amount",
        "min": 0,
        "max": 0.06,
        "step": 0.01,
        "target": "video.grain.amount"
      }
    ]
  },
  "video_stack": [
    {
      "id": "sharpen",
      "node": "edge_sharpen",
      "params": {
        "amount": 0.08
      }
    },
    {
      "id": "grain",
      "node": "grain",
      "params": {
        "amount": 0.012,
        "scale": 1.15,
        "speed": 0
      }
    },
    {
      "id": "grade",
      "node": "color_grade",
      "params": {
        "contrast": 0.08,
        "saturation": -0.05,
        "brightness": -0.01,
        "temperature": 0,
        "tint": 0
      }
    }
  ],
  "audio_stack": {
    "enabled": true,
    "input": "synth",
    "master": {
      "volume": 0.18
    },
    "chain": [
      {
        "node": "noise_bed",
        "params": {
          "level": 0.02,
          "color": "pink"
        }
      },
      {
        "node": "highpass",
        "params": {
          "cutoff": 170,
          "q": 0.7
        }
      },
      {
        "node": "compressor_limiter",
        "params": {
          "threshold": -22,
          "ratio": 4,
          "attack": 0.015,
          "release": 0.25,
          "ceiling": -8
        }
      }
    ]
  },
  "reactive": {
    "analyser_to_params": []
  },
  "references": {
    "dimensions": [
      "docs/references/dimensions/hyperarousal.md",
      "docs/references/dimensions/hypervigilance.md",
      "docs/references/dimensions/intrusion.md"
    ]
  }
}
