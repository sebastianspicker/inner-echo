{
  "id": "dissociation",
  "label": "Dissociation",
  "summary": "A metaphor of detachment and unreality: subtle temporal smear and chromatic drift, with strong Safe Mode limits.",
  "framing": {
    "type": "metaphor",
    "disclaimer": "This is a metaphorical overlay for understanding and reflection. It does not diagnose or replicate clinical reality."
  },
  "experience_dimensions": [
    {
      "id": "derealization",
      "weight": 0.75
    },
    {
      "id": "depersonalization",
      "weight": 0.7
    },
    {
      "id": "time_dilation",
      "weight": 0.4
    }
  ],
  "safety": {
    "intensity_default": 0.35,
    "intensity_max": 0.6,
    "warnings": [
      "Temporal effects may feel disorienting. Use Safe Mode or stop at any time.",
      "Enable Reduced Motion if you are sensitive to motion."
    ],
    "safe_mode_clamps": {
      "max_intensity": 0.6,
      "max_temporal_feedback": 0.25,
      "max_chroma": 0.35
    }
  },
  "ui": {
    "controls": [
      {
        "id": "intensity",
        "type": "slider",
        "label": "Intensity",
        "min": 0,
        "max": 1,
        "step": 0.01
      },
      {
        "id": "safe_mode",
        "type": "toggle",
        "label": "Safe Mode"
      },
      {
        "id": "chroma_amount",
        "type": "slider",
        "label": "Chromatic drift",
        "min": 0,
        "max": 0.12,
        "step": 0.01,
        "target": "video.chroma.amount"
      },
      {
        "id": "smear_feedback",
        "type": "slider",
        "label": "Temporal smear",
        "min": 0,
        "max": 0.7,
        "step": 0.01,
        "target": "video.temporal_smear.feedback"
      },
      {
        "id": "smear_jitter",
        "type": "slider",
        "label": "Smear jitter",
        "min": 0,
        "max": 0.08,
        "step": 0.005,
        "target": "video.temporal_smear.jitter"
      }
    ]
  },
  "video_stack": [
    {
      "id": "chroma",
      "node": "chromatic_aberration",
      "params": {
        "amount": 0.03
      }
    },
    {
      "id": "temporal_smear",
      "node": "temporal_smear",
      "params": {
        "feedback": 0.45,
        "jitter": 0.02
      }
    }
  ],
  "audio_stack": {
    "enabled": false
  },
  "reactive": {
    "analyser_to_params": []
  },
  "references": {
    "dimensions": [
      "docs/references/dimensions/derealization.md",
      "docs/references/dimensions/depersonalization.md",
      "docs/references/dimensions/time_dilation.md"
    ],
    "note": "No dimension 'dissociation' in Scientific/; mapped to derealization + depersonalization + time_dilation."
  }
}

